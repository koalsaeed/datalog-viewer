{
  "name": "datalog-viewer-tests",
  "private": true,
  "type": "module",
  "description": "Browser tests for the viewer page (assets/viewer/index.html) that the Android app loads.",
  "scripts": {
    "fetch": "node fetch-fixtures.mjs",
    "test": "node fetch-fixtures.mjs && node --test --test-concurrency=1",
